{
  "name": "chatvardage",
  "version": "2.0.0",
  "main": "main.js",
  "scripts": {
    "prestart": "node -e \"if (process.env.NODE_ENV !== 'development') { require('child_process').execSync('npm run build:login', { stdio: 'inherit' }); }\"",
    "start": "node scripts/start.js",
    "start:dev": "cross-env NODE_ENV=development node scripts/start.js",
    "dev:login": "vite",
    "build:login": "vite build",
    "build": "npm run build:login",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,html,css,md,txt}\"",
    "dev": "npm run start:dev",
    "build:win": "npm run build:login && npx --yes electron-builder@26.0.12 --win --publish never",
    "build:mac": "npm run build:login && npx --yes electron-builder@26.0.12 --mac --publish never",
    "build:linux": "npm run build:login && npx --yes electron-builder@26.0.12 --linux --publish never",
    "build:all": "npm run build:login && npx --yes electron-builder@26.0.12 --win --mac --linux --publish never"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "description": "Application pour communiquer par des chats - ChatVardage",
  "keywords": [
    "chatvardage",
    "chatbot",
    "electron"
  ],
  "author": "Eva-afk",
  "license": "ISC",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3"
  },
  "build": {
    "appId": "ca.cegep.chatvardage",
    "productName": "ChatVardage",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "src/**/*",
      "!src/**/*.test.js",
      "!src/**/*.test.ts",
      "assets/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Network"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
